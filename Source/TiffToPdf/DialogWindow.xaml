<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TiffToPdf.DialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Drag area; the close caption button sits on the right -->
        <Grid x:Name="DialogTitleBar" Height="32" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,0,24,24" Spacing="12">
                <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <ContentPresenter x:Name="Body" />
            </StackPanel>
        </ScrollViewer>

        <!-- Button bar, like a ContentDialog's -->
        <Grid Grid.Row="2" Padding="24" ColumnSpacing="8" Background="{ThemeResource LayerFillColorAltBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PrimaryButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                    Click="Primary_Click" />
            <Button x:Name="CloseButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="Close_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Window>
